<div th:fragment="content">
    <div class="row g-4 mt-2">
        <div class="col-12">
            <h3 class="fw-bold mb-3"><i class="fa-solid fa-clock-rotate-left text-warning"></i> Lịch sử mua hàng</h3>
        </div>

        <div class="col-12" th:if="${orders != null and !orders.isEmpty()}">
            <div class="bg-white rounded shadow-sm p-4 table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr class="text-secondary" style="border-bottom: 2px solid #eee;">
                            <th>Mã đơn hàng</th>
                            <th>Ngày đặt hàng</th>
                            <th>Người nhận</th>
                            <th>Tổng số tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr th:each="order : ${orders}">
                            <td>
                                <span class="fw-bold text-dark" th:text="'#' + ${order.id}">#1</span>
                            </td>
                            <td th:text="${#temporals.format(order.orderDate, 'dd/MM/yyyy HH:mm')}">Date</td>
                            <td th:text="${order.fullname}">Name</td>
                            <td>
                                <span class="fw-bold text-danger" th:text="${#numbers.formatDecimal(order.totalAmount, 0, 'COMMA', 0, 'POINT')} + ' ₫'">0 ₫</span>
                            </td>
                            <td>
                                <span class="badge" 
                                      th:classappend="${order.status == 'PENDING' ? 'bg-warning text-dark' : 
                                                       (order.status == 'CONFIRMED' ? 'bg-primary' : 
                                                       (order.status == 'DELIVERED' ? 'bg-success' : 'bg-danger'))}"
                                      th:text="${order.status == 'PENDING' ? 'Đang xử lý' : 
                                                (order.status == 'CONFIRMED' ? 'Đã xác nhận' : 
                                                (order.status == 'DELIVERED' ? 'Đã giao' : 'Đã hủy'))}">
                                    PENDING
                                </span>
                            </td>
                            <td class="text-center">
                                <a th:href="@{/order/{id}(id=${order.id})}" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                    Xem <i class="fa-solid fa-arrow-right-long text-primary small"></i>
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Empty State -->
        <div class="col-12 py-5 text-center bg-white rounded shadow-sm" th:if="${orders == null or orders.isEmpty()}">
            <div class="fs-1 mb-2">📦</div>
            <h4 class="fw-bold text-dark">Bạn chưa đặt đơn hàng nào!</h4>
            <p class="text-muted">Hãy xem và chọn mua những cuốn sách hấp dẫn của chúng tôi.</p>
            <a th:href="@{/}" class="btn btn-primary px-4 mt-3">Mua hàng ngay</a>
        </div>
    </div>
</div>
