<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng ký thành viên - BOOKSHOP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" th:href="@{/css/auth.css}">
</head>
<body class="bg-light d-flex align-items-center justify-content-center py-5" style="min-height: 100vh;">

<div class="auth-container" style="max-width: 500px; width: 100%;">
    <div class="card border-0 shadow-lg p-4 bg-white rounded-4 mx-3">
        <div class="text-center mb-4">
            <div class="auth-logo-icon mb-2"><i class="fa-solid fa-user-plus text-primary"></i></div>
            <h3 class="fw-bold text-dark mb-1">Đăng ký thành viên</h3>
            <p class="text-secondary small">Trở thành thành viên BOOKSHOP để nhận ưu đãi</p>
        </div>

        <div th:if="${error}" class="alert alert-danger d-flex align-items-center gap-2 py-2" role="alert" th:text="${error}">
            Lỗi đăng ký tài khoản.
        </div>

        <form th:action="@{/auth/register}" th:object="${user}" method="post">
            <div class="row g-3">
                <!-- Username -->
                <div class="col-12">
                    <label class="form-label text-secondary fw-semibold">Tên đăng nhập *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-user"></i></span>
                        <input type="text" th:field="*{username}" class="form-control border-start-0 ps-0" placeholder="Tên đăng nhập" required>
                    </div>
                </div>

                <!-- Password -->
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold">Mật khẩu *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" th:field="*{password}" class="form-control border-start-0 ps-0" placeholder="Nhập mật khẩu" required>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold">Nhập lại mật khẩu *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" name="confirmPassword" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu" required>
                    </div>
                </div>

                <!-- Fullname -->
                <div class="col-12">
                    <label class="form-label text-secondary fw-semibold">Họ và tên *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-signature"></i></span>
                        <input type="text" th:field="*{fullname}" class="form-control border-start-0 ps-0" placeholder="Họ và tên đầy đủ" required>
                    </div>
                </div>

                <!-- Email -->
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                        <input type="email" th:field="*{email}" class="form-control border-start-0 ps-0" placeholder="example@domain.com">
                    </div>
                </div>

                <!-- Phone -->
                <div class="col-md-6">
                    <label class="form-label text-secondary fw-semibold">Số điện thoại</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-phone"></i></span>
                        <input type="tel" th:field="*{phone}" class="form-control border-start-0 ps-0" placeholder="Số điện thoại di động">
                    </div>
                </div>

                <!-- Address -->
                <div class="col-12">
                    <label class="form-label text-secondary fw-semibold">Địa chỉ giao hàng mặc định</label>
                    <textarea th:field="*{address}" class="form-control" rows="2" placeholder="Số nhà, đường, phường, xã, thành phố..."></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 mt-4">
                Đăng ký tài khoản <i class="fa-solid fa-circle-check"></i>
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="text-secondary small mb-0">
                Đã có tài khoản? 
                <a th:href="@{/auth/login}" class="text-primary fw-bold text-decoration-none hover-underline">Đăng nhập ngay</a>
            </p>
            <div class="mt-3">
                <a th:href="@{/}" class="text-secondary text-decoration-none small"><i class="fa-solid fa-house"></i> Quay lại cửa hàng</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
