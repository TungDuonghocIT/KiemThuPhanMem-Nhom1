<div th:fragment="sidebar" class="sidebar p-3 bg-light rounded shadow-sm">
    <ul class="list-group">
        <!-- Home Link -->
        <li class="list-group-item border-0">
            <a th:href="@{/}" class="menu-link d-flex align-items-center gap-2"
               th:classappend="${currentCategory == null and keyword == null and contentTemplate == 'pages/home'} ? 'active' : ''">
                <i class="fa-solid fa-house"></i>
                <span>Tất cả sách</span>
            </a>
        </li>

        <!-- Category Title -->
        <li class="list-group-item border-0 fw-bold pb-2 pt-3 text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">
            <i class="fa-solid fa-list-ul"></i> Danh mục
        </li>

        <!-- Dynamically rendered Categories -->
        <li class="list-group-item border-0" th:each="cat : ${categories}">
            <a th:href="@{/category/{id}(id=${cat.id})}" 
               class="menu-link d-flex align-items-center gap-2"
               th:classappend="${currentCategory != null and currentCategory.id == cat.id} ? 'active' : ''">
                <i class="fa-solid fa-book text-muted small"></i>
                <span th:text="${cat.name}">Danh mục</span>
            </a>
        </li>
    </ul>
</div>