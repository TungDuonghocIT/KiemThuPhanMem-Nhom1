<div th:fragment="sidebar" class="list-group shadow-sm border-0 rounded-3">
    <a th:href="@{/admin/dashboard}" 
       class="list-group-item list-group-item-action fw-semibold py-3 border-0" 
       th:classappend="${activeTab == 'dashboard'} ? 'active' : ''">
        <i class="fa-solid fa-gauge-high me-2"></i> Dashboard
    </a>
    <a th:href="@{/admin/list}" 
       class="list-group-item list-group-item-action fw-semibold py-3 border-0" 
       th:classappend="${activeTab == 'books'} ? 'active' : ''">
        <i class="fa-solid fa-book me-2"></i> Quản lý sách
    </a>
    <a th:href="@{/admin/categories}" 
       class="list-group-item list-group-item-action fw-semibold py-3 border-0" 
       th:classappend="${activeTab == 'categories'} ? 'active' : ''">
        <i class="fa-solid fa-list-ul me-2"></i> Quản lý danh mục
    </a>
    <a th:href="@{/admin/orders}" 
       class="list-group-item list-group-item-action fw-semibold py-3 border-0" 
       th:classappend="${activeTab == 'orders'} ? 'active' : ''">
        <i class="fa-solid fa-receipt me-2"></i> Quản lý đơn hàng
    </a>
    <a th:href="@{/admin/customers}" 
       class="list-group-item list-group-item-action fw-semibold py-3 border-0" 
       th:classappend="${activeTab == 'customers'} ? 'active' : ''">
        <i class="fa-solid fa-users me-2"></i> Quản lý khách hàng
    </a>
    <a th:href="@{/admin/statistics}" 
       class="list-group-item list-group-item-action fw-semibold py-3 border-0" 
       th:classappend="${activeTab == 'statistics'} ? 'active' : ''">
        <i class="fa-solid fa-chart-pie me-2"></i> Quản lý thống kê
    </a>
</div>
