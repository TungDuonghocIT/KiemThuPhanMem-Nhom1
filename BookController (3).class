<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - Chỉnh sửa sách</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" th:href="@{/css/admin.css}">
</head>
<body class="bg-light">

<!-- Navbar -->
<nav class="navbar navbar-dark bg-dark shadow px-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-warning d-flex align-items-center gap-2" th:href="@{/admin/dashboard}">
            <i class="fa-solid fa-book-open"></i> BOOKSHOP Admin
        </a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white small">
                Xin chào, <b th:text="${session.username}">Admin</b>
            </span>
            <a th:href="@{/auth/logout}" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div th:replace="~{fragments/admin-sidebar :: sidebar}"></div>
        </div>

        <!-- Content -->
        <div class="col-md-9">
            <div class="bg-white p-4 rounded shadow-sm">
                <h3 class="fw-bold mb-4 text-dark border-bottom pb-2">
                    <i class="fa-solid fa-pen-to-square text-warning"></i> Chỉnh sửa sách
                </h3>

                <form th:action="@{/admin/update/{id}(id=${book.id})}" th:object="${book}" method="post">
                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-md-6">
                            <label for="title" class="form-label fw-semibold">Tiêu đề sách</label>
                            <input type="text" class="form-control" id="title" th:field="*{title}" required>
                        </div>

                        <!-- Author -->
                        <div class="col-md-6">
                            <label for="author" class="form-label fw-semibold">Tác giả</label>
                            <input type="text" class="form-control" id="author" th:field="*{author}" required>
                        </div>

                        <!-- Category Dropdown -->
                        <div class="col-md-4">
                            <label for="categoryId" class="form-label fw-semibold">Danh mục</label>
                            <select class="form-select" id="categoryId" name="categoryId" required>
                                <option value="" disabled>Chọn danh mục...</option>
                                <option th:each="cat : ${categories}" 
                                        th:value="${cat.id}" 
                                        th:text="${cat.name}"
                                        th:selected="${book.category != null and book.category.id == cat.id}"></option>
                            </select>
                        </div>

                        <!-- Price -->
                        <div class="col-md-4">
                            <label for="price" class="form-label fw-semibold">Giá bán (₫)</label>
                            <input type="number" class="form-control" id="price" th:field="*{price}" required min="0">
                        </div>

                        <!-- Quantity -->
                        <div class="col-md-4">
                            <label for="quantity" class="form-label fw-semibold">Số lượng trong kho</label>
                            <input type="number" class="form-control" id="quantity" th:field="*{quantity}" required min="0">
                        </div>

                        <!-- Image URL -->
                        <div class="col-12">
                            <label for="imageUrl" class="form-label fw-semibold">Đường dẫn ảnh bìa</label>
                            <input type="text" class="form-control" id="imageUrl" th:field="*{imageUrl}" required>
                            <div class="form-text">Bạn có thể dùng đường dẫn ảnh cục bộ trong thư mục static (ví dụ: <code>/images/dacnhantam.png</code>) hoặc URL ảnh online.</div>
                        </div>

                        <!-- Image Preview -->
                        <div class="col-12 mt-2">
                            <label class="form-label fw-semibold text-secondary">Ảnh hiển thị hiện tại / Xem trước:</label>
                            <div>
                                <img id="imagePreview" th:src="${book.imageUrl}" alt="Preview" class="img-thumbnail rounded shadow-sm" style="max-height: 200px; object-fit: cover;" onerror="this.src='/images/default.png';">
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label for="description" class="form-label fw-semibold">Mô tả ngắn</label>
                            <textarea class="form-control" id="description" th:field="*{description}" rows="4"></textarea>
                        </div>

                        <!-- Actions -->
                        <div class="col-12 d-flex gap-2 justify-content-end mt-4">
                            <a th:href="@{/admin/list}" class="btn btn-outline-secondary px-4 fw-bold">Hủy bỏ</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">Lưu thay đổi</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Fix nháy màn hình: dùng Image preloader - chỉ cập nhật src khi ảnh load thành công
    const imgUrlInput = document.getElementById('imageUrl');
    const previewImg = document.getElementById('imagePreview');
    let debounceTimer = null;

    function preloadAndUpdate(url) {
        if (!url) {
            previewImg.src = '/images/default.png';
            return;
        }
        const tempImg = new Image();
        tempImg.onload = function() {
            previewImg.src = url;  // Chỉ cập nhật khi ảnh load thành công
        };
        tempImg.onerror = function() {
            previewImg.src = '/images/default.png';  // Giữ ảnh mặc định nếu URL lỗi
        };
        tempImg.src = url;  // Load ảnh tạm, chưa hiển thị ra màn hình
    }

    imgUrlInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function() {
            preloadAndUpdate(imgUrlInput.value.trim());
        }, 400);  // Debounce 400ms, không load khi đang gõ liên tục
    });
</script>
</body>
</html>