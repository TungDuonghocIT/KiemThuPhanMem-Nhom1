<div th:fragment="content">
    <h2 class="mb-3">Danh sách sách</h2>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
       
                <th>Tên sách</th>
                <th>Giá</th>
            </tr>
        </thead>
        <tbody>
            <tr th:each="b : ${books}">
        
                <td th:text="${b.title}"></td>
                <td th:text="${b.price}"></td>
            </tr>
        </tbody>
    </table>
</div>